# ---------- Database ----------
# Local MySQL:
# DATABASE_URL="mysql://root:password@localhost:3306/taskboard"
#
# TiDB Cloud Starter (recommended for Vercel):
# Console -> Connect -> Prisma -> copy connection string (port 4000)
DATABASE_URL="mysql://USERNAME:PASSWORD@GATEWAY.host.tidbcloud.com:4000/taskboard?sslaccept=strict"

# Optional force switch: 1 = always TiDB adapter, 0 = always TCP
# TIDB_ADAPTER=1

# ---------- Auth ----------
# Production: use a long random string, e.g. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ---------- API ----------
# mock = in-memory demo; http = real backend (use http for production)
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=/api
